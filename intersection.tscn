[sub_resource type="GDScript" id="GDScript_oqynk"]
script/source = "extends Node3D

@export var car_scene: PackedScene # Drag your Car.tscn here in the Inspector
@export var spawn_interval: float = 1.5 # Time in seconds between spawns
@export var speed_variation: float = 2.0

var timer: float = 0.0

func _process(delta: float):
	timer += delta
	if timer >= spawn_interval:
		timer = 0.0
		spawn_car()

func spawn_car():
	if not car_scene:
		print(\"Error: Car scene not assigned in spawner!\")
		return
		
	var car = car_scene.instantiate()
	
	# Spawn at the spawner's position (with a tiny random offset across the lane)
	var random_offset_x = randf_range(-0.5, 0.5)
	car.position = global_position + Vector3(random_offset_x, 0, 0)
	
	# Optional: randomize individual car speeds slightly
	if \"speed\" in car:
		car.speed += randf_range(-speed_variation, speed_variation)
		
	# Add the car to the main scene tree
	get_tree().current_scene.add_child(car)
"

